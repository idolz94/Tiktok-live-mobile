{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@declare": ["./declare/index"],
      "@declare/*": ["./declare/*"],
      "@types": ["./src/types"],
      "@screens/*": ["./src/screens/*"],
      "@stores/*": ["./src/stores/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@components/*": ["./src/components/*"],
      "@utils/*": ["./src/utils/*"],
      "@themes/*": ["./src/themes/*"],
      "@themes": ["./src/themes/index"],
      "@features/*": ["./src/features/*"],
      "@constants/*": ["./src/constants/*"]
    }
  }
}
