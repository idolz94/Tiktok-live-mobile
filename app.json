{
  "expo": {
    "name": "TikTok Live Tools",
    "slug": "tiktok-live-tools",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "router": { "root": "src" },
    "scheme": "lumilive",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.idolz94.tiktoklivetools"
    },
    "android": {
      "package": "com.idolz94.tiktoklivetools"
    },
    "extra": {
      "apiUrl": "http://localhost:8765"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-image-picker",
      "expo-router",
      "expo-status-bar"
    ]
  }
}
