{
  "expo": {
    "name": "Lumi Live",
    "slug": "lumi-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lumilive",
    "icon": "./src/assets/images/sources/logo-app.png",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.idolz94.tiktoklivetools",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.idolz94.tiktoklivetools",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "apiUrl": "http://localhost:8765",
      "router": {},
      "eas": {
        "projectId": "c44ddee3-2cad-48c1-9881-d2322501c5c9"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lumi cần quyền truy cập camera để chụp ảnh hàng hoá."
        }
      ]
    ]
  }
}
